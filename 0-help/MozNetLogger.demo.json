{
  "httpLog": {
    "filters": [
      {
        "urlPattern": "^https://api\\.example\\.com/",
        "saveDir": "C:\\netlog\\example-api"
      },
      {
        "urlPattern": "/v1/(users|orders)\\b",
        "saveDir": "C:\\netlog\\v1-endpoints"
      },
      {
